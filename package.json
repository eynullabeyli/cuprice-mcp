{
  "name": "cuprice-mcp",
  "version": "1.0.0",
  "description": "MCP server for Cuprice pricing platform",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:stdio": "node dist/src/index.js",
    "dev": "tsx src/server.ts",
    "dev:stdio": "tsx src/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "cuprice",
    "pricing"
  ],
  "author": "Cuprice",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^4.21.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
